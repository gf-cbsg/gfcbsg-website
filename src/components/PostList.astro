---
import { isoDate, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** 'grid' shows the posts as a row of cards on wide screens. */
  layout?: 'list' | 'grid';
}
const { posts, layout = 'list' } = Astro.props;

// Small labels so visitors can spot posts with videos or photos.
const hasVideo = (post: Post) => post.data.videos.length > 0;
const hasPhotos = (post: Post) =>
  post.data.photos.length > 0 || /!\[[^\]]*\]\(/.test(post.body ?? '');
---

<ul class:list={['post-list', { 'post-grid': layout === 'grid' }]}>
  {
    posts.map((post) => (
      <li>
        <a href={postUrl(post)}>
          <span class="post-title" lang={post.data.lang}>
            {post.data.title}
          </span>
          <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
          {(hasVideo(post) || hasPhotos(post)) && (
            <span class="post-tags">
              {hasVideo(post) && (
                <span class="tag">
                  <span lang="zh-Hans">视频</span> <span lang="en">Video</span>
                </span>
              )}
              {hasPhotos(post) && (
                <span class="tag">
                  <span lang="zh-Hans">照片</span> <span lang="en">Photos</span>
                </span>
              )}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>
