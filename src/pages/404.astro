---
import Base from '../layouts/Base.astro';
---

<Base title="找不到页面 Page not found">
  <section class="container page-head">
    <h1 class="bi">
      <span lang="zh-Hans">找不到页面</span>{' '}
      <span lang="en">Page not found</span>
    </h1>
    <p>
      <span lang="zh-Hans">您要找的页面不存在或已移动。</span>
      <br />
      <span lang="en">The page you are looking for doesn't exist or has moved.</span>
    </p>
    <p>
      <a class="button" href="/">
        <span lang="zh-Hans">回到首页</span>{' '}
        <span lang="en">Go to the home page</span>
      </a>
    </p>
  </section>
</Base>
