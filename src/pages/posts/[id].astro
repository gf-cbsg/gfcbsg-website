---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { site } from '../../config/site';
import { getPosts, isoDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = isoDate(post.data.date);
const videos = post.data.videos.map((video, index) => {
  const { url, title } = typeof video === 'string' ? { url: video, title: undefined } : video;
  const fallback = post.data.videos.length > 1 ? `${post.data.title} (${index + 1})` : post.data.title;
  return { url, title: title ?? fallback, showTitle: Boolean(title) };
});
const description =
  post.data.description ?? `${post.data.title}（${date}）· ${site.name.zh} ${site.name.en}`;
---

<Base title={post.data.title} description={description} lang={post.data.lang} type="article">
  <article class="container page-head">
    <p class="crumb">
      <a href="/archive/">← <span lang="zh-Hans">历年活动</span> <span lang="en">Archive</span></a>
    </p>
    <h1>{post.data.title}</h1>
    <p class="post-date"><time datetime={date}>{date}</time></p>
    {videos.map((video) => <VideoEmbed {...video} />)}
    <div class="prose">
      <Content />
    </div>
    {post.data.photos.length > 0 && <PhotoGallery photos={post.data.photos} />}
    {
      post.data.missing_attachment && (
        <aside class="note">
          <p>
            <span lang="zh-Hans">原帖附有 Google Drive 文件夹，目前已无法公开访问。</span>{' '}
            <span lang="en">
              The original post linked to a Google Drive folder that is no longer publicly
              available.
            </span>
          </p>
        </aside>
      )
    }
  </article>
</Base>
